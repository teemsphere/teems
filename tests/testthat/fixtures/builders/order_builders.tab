File INFILE # data #;
Set COM # commodities # (c1, c2, c3);
Coefficient (all,c,COM) X(c) # data #;
Read X from file INFILE header "XDAT";
Coefficient (all,c,COM) Z(c) # zeros #;
Read Z from file INFILE header "ZDAT";
Coefficient A # switch #;
Coefficient (all,c,COM) B(c) # scaled #;
Formula A = 1;
Formula (all,c,COM) B(c) = A*X(c);
Formula A = 0;
Set ORD # by statement order # = (all,c,COM: B(c) + A > 2.5);
Coefficient (all,c,COM) Y(c) # read then modified #;
Read Y from file INFILE header "YDAT";
Formula (all,c,COM) Y(c) = Y(c) - 10;
Set MOD # after the formula # = (all,c,COM: Y(c) > 0);
Zerodivide default 7;
Coefficient (all,c,COM) Q(c) # ratio #;
Formula (all,c,COM) Q(c) = X(c)/Z(c);
Set ZD # zerodivide default # = (all,c,COM: Q(c) > 5);
Coefficient (all,c,COM) N(c) # accumulator #;
Formula (all,c,COM) N(c) = 0;
Formula (all,c,COM) N(c) = N(c) + X(c);
Formula (all,c,COM) N(c) = N(c) + 1;
Set ACC # accumulated # = (all,c,COM: N(c) > 3.5);
Variable (all,c,COM) v(c) # quantity #;
Equation E_v (all,c,COM) v(c) = 0;

File INFILE # data #;
Set COM # commodities # (c1, c2, c3);
Set SUB # the first commodity # (c1);
Subset SUB is subset of COM;
Coefficient (all,c,COM) X(c) # data #;
Read X from file INFILE header "XDAT";
Set PREC # unary minus binds before ^ # = (all,c,COM: -X(c)^2 > -3);
Set LEFT # ^ associates to the left # = (all,c,COM: X(c)^3^2 > 100);
Coefficient (all,c,COM) Z0(c) # zeros #;
Formula (all,c,COM) Z0(c) = 0;
Zerodivide (nonzero_by_zero) default 9;
Set NZD # 0/0 takes the zero_by_zero default # = (all,c,COM: 0/Z0(c) > 1);
Set NBZ # nonzero/0 takes its own default # = (all,c,COM: X(c)/Z0(c) > 5);
Coefficient (all,c,COM) F(c) # reassigned after the Set #;
Formula (all,c,COM) F(c) = 0;
Formula (all,c,SUB) F(c) = 1;
Set LATER # sees only the Formulas before it # = (all,c,COM: F(c) > 0.5);
Formula (all,c,COM) F(c) = 2;
Variable (all,c,COM) v(c) # quantity #;
Equation E_v (all,c,COM) v(c) = 0;

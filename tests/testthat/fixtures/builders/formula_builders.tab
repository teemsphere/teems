File INFILE # data #;
Set COM # commodities # (c1, c2, c3);
Set IND # industries # (i1, i2, i3);
Set REG # regions # (r1, r2);
Coefficient (all,c,COM)(all,i,IND)(all,r,REG) MAKE(c,i,r) # make #;
Read MAKE from file INFILE header "MAKE";
Coefficient (all,c,COM)(all,i,IND) MAKE_D(c,i) # national make #;
Formula (all,c,COM)(all,i,IND) MAKE_D(c,i) = sum{r,REG, MAKE(c,i,r)};
Coefficient (integer,parameter)(all,i,IND) NCOMPROD(i) # commodities made #;
Formula (initial) (all,i,IND) NCOMPROD(i) = sum{c,COM:MAKE_D(c,i)<>0,1};
Coefficient (all,i,IND) MAKE_C(i) # industry output #;
Formula (all,i,IND) MAKE_C(i) = sum{c,COM, MAKE_D(c,i)};
Coefficient (all,i,IND) LOCPROD(i) # output of c1 #;
Formula (all,i,IND) LOCPROD(i) = MAKE_D("c1",i);
Mapping I2R from IND to REG;
Read (by_elements) I2R from file INFILE header "I2R";
Set MIND # multi-product industries # = (all,i,IND:NCOMPROD(i)>1);
Set MINDCOM # made by MIND # = (all,c,COM:sum{i,MIND,ABS[MAKE_D(c,i)]}>0);
Set LOCIND # mostly c1 # = (all,i,IND: LOCPROD(i) > 0.8*MAKE_C(i));
Set FIRST # first industry # = (all,i,IND: $pos(i) = 1);
Set BOTH # multi and large # = (all,i,IND: [NCOMPROD(i) > 1] and [LOCPROD(i) > 0]);
Set R1IND # industries of r1 # = (all,i,IND: I2R(i) = "r1");
Variable (all,i,IND) x(i) # output #;
Equation E_x (all,i,IND) x(i) = 0;

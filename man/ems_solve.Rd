\dontrun{
# The following examples require the teems solver to be built. 
# See https://teemsphere.github.io/ to get started.
 
# Solving a static model with Gragg 2-4-8 (the default):
ems_solve(cmf_path)

# A quick one-step approximation:
ems_solve(cmf_path, solution_method = "Johansen")

# Solving a dynamic model with the SBBD method:
ems_solve(cmf_path,
          solution_method = "Gragg",
          matrix_method = "SBBD",
          n_tasks = 6)
}
}
